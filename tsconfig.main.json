{
  // Solo controllo (niente emissione): main e codice condiviso con i controlli più severi che
  // il renderer, a script globali, non regge ancora. La build resta su tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": true
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts", "src/global.d.ts"]
}
